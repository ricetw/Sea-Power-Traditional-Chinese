<!-- Pacific Strike classified coastwatcher event: naval-message paper format. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" MinHeight="1000" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="海軍電文" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
        <TextBlock Grid.Column="1" Text="*******機　密*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="海軍部" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
      </Grid>

      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
          優先<LineBreak/>
          O 192000Z AUG 85
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" FontSize="16" Text="ZYUW RAYOC0777 2312000"/>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="發自"/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="COASTWATCHER NET LOMBOK VIA RAN DARWIN NT AU"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="致"/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="CTF 77 DARWIN NT AU"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="副知"/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16">
          CINCPACFLT PEARL HARBOR HI<LineBreak/>
          HQ AIR COMMAND RAAF GLENBROOK NSW AU<LineBreak/>
          INDONESIAN NAVAL LIAISON DARWIN NT AU
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="主旨"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="海岸觀察員報告 - 峇里／龍目地區"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        機密
        <LineBreak/>
        電文分隔
        <LineBreak/><LineBreak/>
        1.（機密）摘要：盟軍海岸觀察員來源回報，蘇聯及其盟軍正鞏固登巴薩機場與龍目海峽周邊陣地。敵軍活動顯示其正準備抵禦水面兵力穿越海峽。
        <LineBreak/><LineBreak/>
        2.（機密）目視發現：8 月 19 日黃昏前，在龍目海峽北方觀察到兩艘驅逐艦級戰鬥艦。據報較小型快速巡邏艇在海峽內成對活動。多艘武裝輔助船與登陸艇仍停留於峇里附近。
        <LineBreak/><LineBreak/>
        3.（機密）岸防：觀察員回報登巴薩機場附近有雷達運作與重砲陣地。至少一處疑似岸基飛彈連在過去 48 小時內已轉移兩次。機場附近亦通報有高射砲陣地。
        <LineBreak/><LineBreak/>
        4.（機密）空中活動：觀察到少量短場起飛噴射機自峇里機場運作。飛機停留於當地，未追逐視距外民用交通。沿岸仍有縱列旋翼直升機巡邏，配備反戰車武器與炸彈，研判可能為港內拍攝到的伊凡・羅戈夫級或蟾蜍級戰車登陸艦所搭載的 Ka-29。
        <LineBreak/><LineBreak/>
        5.（機密）民用交通：儘管已多次警告，仍有漁船停留於龍目海峽。部分船隻可能受敵軍監視或脅迫。交戰前必須完成確實識別。
        <LineBreak/><LineBreak/>
        6.（機密）評估：敵軍意圖阻撓盟軍通行，以延宕對印尼的救援。消息來源回報該近區尚無確認潛艦活動。
        <LineBreak/><LineBreak/>
        署名：M. S. SULLIVAN 上校，澳洲皇家海軍
		<LineBreak/>
		ROYAL 澳洲N NAVY LIAISON
        <LineBreak/><LineBreak/>
        電文分隔
        <LineBreak/>
        機密 依原機關決定解密
      </TextBlock>
    </StackPanel>
  </Border>
</ScrollViewer>
