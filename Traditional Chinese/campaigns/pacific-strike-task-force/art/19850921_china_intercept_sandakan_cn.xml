<!-- Pacific Strike CIA memorandum event, adapted from Strike Group Molniya U.S.-voice interstitial format. -->
<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080">
  <Viewbox>
    <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="864" Height="1120" Padding="45"
            TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16">
      <Border.Effect>
        <DropShadowEffect />
      </Border.Effect>

      <Border BorderThickness="0,10,10,10" BorderBrush="#FF000000">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="C05084534" Background="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,-15,0,0" Padding="5,0,5,0" />
          <Grid Grid.Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="15"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="最高機密" TextAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2" TextAlignment="Center" FontFamily="Times New Roman">
              The Director of Central Intelligence
              <LineBreak/>
              <LineBreak/>
              <Run FontSize="12">Washington D.C., 20505</Run>
            </TextBlock>
            <TextBlock Grid.Row="4" Grid.Column="3" Text="21 September 1985"/>
            <TextBlock Grid.Row="6" Grid.Column="3" Text="222X1"/>
            <TextBlock Grid.Row="7" Grid.Column="0" Text="MEMORANDUM FOR:   "/>
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap">
              JCS WASHINGTON DC//J3//
              <LineBreak/>
              USCINCPAC HONOLULU HI
              <LineBreak/>
              CINCPACFLT PEARL HARBOR HI
              <LineBreak/>
              COMUSPHIL MANILA PI
            </TextBlock>
            <TextBlock Grid.Row="7" Grid.Column="3" TextWrapping="Wrap">
              行政命令 13526 3.3(b)(1)&gt;25年
              <LineBreak/>
              行政命令 13526 3.5(c)
            </TextBlock>
            <TextBlock Grid.Row="9" Grid.Column="0" Text="主旨ECT:   "/>
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Text="山打根突襲後的中國指揮通聯"/>
          </Grid>
          <TextBlock Grid.Row="2" TextWrapping="Wrap">
            1. 公主港市內受控情報來源「星光」傳來中國指揮通聯，內容承認山打根打擊未能摧毀盟軍兩棲集結兵力。通聯內容反映其急切擔憂盟軍已部署完成，準備對巴拉望採取行動。
            <LineBreak/>
            <LineBreak/>
            2. 解放軍與中國海軍管道命令巴拉望指揮官不惜一切代價守住公主港與奎松。其請求項目包括額外岸基飛彈再裝填彈、工兵、彈藥、機動防空飛彈系統與岸控分遣隊。其請求金蘭灣蘇聯兵力提供空中掩護與船隊護航。
            <LineBreak/>
            <LineBreak/>
            3. 預期敵軍將透過強化公主港、將預備兵力轉向島西岸奎松，並使用小艇、岸基飛彈與潛艦來抗擊任何登陸行動。
            <LineBreak/>
            <LineBreak/>
			4. 截收報告指出，兩名負責山打根打擊失敗的中國指揮官已被召回大陸，我方來源認為他們將遭處決。我們評估此事將反而強化巴拉望當地指揮官的抵抗決心。
            <LineBreak/>
            <LineBreak/>
            5. 中國與蘇聯指揮官似乎明白巴拉望正處於暴露狀態。基於此，我們評估盟軍若迅速行動，可能趕在其目前請求的增援管道成形之前。
            <LineBreak/>
            <LineBreak/>
          </TextBlock>
          <TextBlock TextAlignment="Right" Text="威廉・J・凱西，局長" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="480,500,0,0" Grid.Row="2"/>
          <TextBlock Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Bottom">
            <Run TextDecorations="Underline">Distribution by ER/21 September 1985 w/Att</Run>
            <LineBreak/>
            <LineBreak/>
            Orig - Each Addressee
            <LineBreak/>
               1 - DCI
            <LineBreak/>
               1 - DDCI
            <LineBreak/>
               1 - EXDIR
            <LineBreak/>
               1 - C/NIC
            <LineBreak/>
               1 - VC/NIC
            <LineBreak/>
               1 - NIO/Warning
            <LineBreak/>
               1 - ER File
          </TextBlock>
          <TextBlock Grid.Row="4" Text="最高機密" TextAlignment="Center"/>
        </Grid>
      </Border>
    </Border>
  </Viewbox>
</Page>
