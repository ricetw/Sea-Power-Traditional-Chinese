<!-- Pacific Strike 17 MAU targeting intelligence event: naval-message paper format. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="海軍電文" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
        <TextBlock Grid.Column="1" Text="*******機　密*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="海軍部" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
      </Grid>

      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
          立即<LineBreak/>
          O 212300Z SEP 85
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" FontSize="16" Text="ZYUW RUHQHQA0777 2642300"/>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="發自"/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="CINCPAC HONOLULU HI"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="致"/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="指揮官 17 MAU AFLOAT"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="副知"/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16">
          CTF 77 山打根 MY<LineBreak/>
          CINCPACFLT PEARL HARBOR HI<LineBreak/>
          COMSUBPAC PEARL HARBOR HI<LineBreak/>
          MARITIME HQ DARWIN NT AU
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="主旨"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="TARGET INTEL - 公主港 設施S"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        機密
        <LineBreak/>
        電文分隔
        <LineBreak/><LineBreak/>
        參考：
        <LineBreak/>
        A. ORION INTREP 20-85/PP, PERISCOPE PHOTO AND ES FIX.
        <LineBreak/>
        B. 太平洋司令部聯合情報中心目標資料夾 PP-CHALLENGER-17。
        <LineBreak/>
        C. 第 77 特遣隊空中／火力支援備忘 21SEP85/CHALLENGER。
        <LineBreak/><LineBreak/>
        1.（機密）摘要：澳洲皇家海軍 ORION 號偵察已在公主港突擊區辨識出 11 處敵方設施。以下資料轉交第 17 陸戰兩棲部隊參謀，用於打擊規劃並降低灘頭進入風險。
        <LineBreak/><LineBreak/>
        2.（機密）目標資料：
      </TextBlock>

      <Border Padding="8" Margin="0,4,0,12">
        <Grid TextElement.FontSize="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="區域"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="數量"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="設施"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="座標 緯度／經度"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,0" Text="空軍基地／RPVP"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,12,0" Text="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,12,0" Text="機場／跑道"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="09-44-21.6N / 118-44-57.0E"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,12,0" Text="空軍基地／RPVP"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,4,12,0" Text="高射砲陣地 A"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" Text="09-44-01.8N / 118-45-09.6E"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,12,0" Text="空軍基地／RPVP"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,4,12,0" Text="高射砲陣地 B"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,4,0,0" Text="09-44-03.6N / 118-45-02.4E"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,12,0" Text="空軍基地／RPVP"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,4,12,0" Text="SA-10/S-300 防空飛彈陣地"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,4,0,0" Text="09-45-14.4N / 118-45-28.2E"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4,12,0" Text="南方進場路線"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,4,12,0" Text="蠶式飛彈發射車 A"/>
          <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,4,0,0" Text="09-40-34.8N / 118-44-21.6E"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,12,0" Text="南方進場路線"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,4,12,0" Text="蠶式飛彈發射車 B"/>
          <TextBlock Grid.Row="6" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.0N / 118-44-25.8E"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,4,12,0" Text="南方進場路線"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,4,12,0" Text="SA-8 發射車 A"/>
          <TextBlock Grid.Row="7" Grid.Column="3" Margin="0,4,0,0" Text="09-40-32.4N / 118-44-18.6E"/>

          <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4,12,0" Text="南方進場路線"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,4,12,0" Text="SA-8 發射車 B"/>
          <TextBlock Grid.Row="8" Grid.Column="3" Margin="0,4,0,0" Text="09-40-39.6N / 118-44-24.0E"/>

          <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,4,12,0" Text="南方進場路線"/>
          <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,4,12,0" Text="SON-9 火控雷達"/>
          <TextBlock Grid.Row="9" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.6N / 118-44-22.2E"/>

          <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4,12,0" Text="北方進場路線"/>
          <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,4,12,0" Text="2"/>
          <TextBlock Grid.Row="10" Grid.Column="2" Margin="0,4,12,0" Text="HY-1 發射車 A"/>
          <TextBlock Grid.Row="10" Grid.Column="3" Margin="0,4,0,0" Text="09-45-25.8N / 118-45-51.6E"/>

          <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,4,12,0" Text="北方進場路線"/>
          <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,4,12,0" Text="2"/>
          <TextBlock Grid.Row="11" Grid.Column="2" Margin="0,4,12,0" Text="HY-1 發射車 B"/>
          <TextBlock Grid.Row="11" Grid.Column="3" Margin="0,4,0,0" Text="09-45-28.8N / 118-45-58.2E"/>
        </Grid>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="16">
        3.（機密）區域摘要：安東尼奧・包蒂斯塔空軍基地（RPVP）區域內有 4 處已辨識設施。南方進場路線有 5 處已辨識設施。北方進場路線有 2 處已辨識設施。已辨識總數為 11 處。
        <LineBreak/><LineBreak/>
        4.（機密）規劃影響：登陸艇進入港口進場路線前，SA-10/S-300 火控、岸基飛彈發射車與相關雷達應列為第一優先壓制目標。高射砲與跑道設施仍應作為後續隔離登陸區的打擊目標。
        <LineBreak/><LineBreak/>
        5.（機密）交接：座標由參考 A 與 B 推導，並依參考 C 打擊規劃格式整理。轉交營級登陸隊、海軍砲火聯絡官、航空聯絡官與支援航空規劃人員。
        <LineBreak/><LineBreak/>
        署名：太平洋司令部值勤中心
        <LineBreak/><LineBreak/>
        電文分隔
        <LineBreak/>
        機密 依原機關決定解密
      </TextBlock>
    </StackPanel>
  </Border>
</ScrollViewer>
