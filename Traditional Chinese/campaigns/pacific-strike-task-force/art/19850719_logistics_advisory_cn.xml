<!-- Pacific Strike classified logistics event: naval-message paper format. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="海軍電文" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
        <TextBlock Grid.Column="1" Text="*******機　密*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="海軍部" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
      </Grid>

      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
          例行<LineBreak/>
          R 192200Z JUL 85
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" FontSize="16" Text="ZYUW RAYOC0777 2002200"/>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="發自"/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="COMSERVPAC DET DARWIN NT AU"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="致"/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="CINCPACFLT PEARL HARBOR HI"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="副知"/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16">
          CTF 77 DARWIN NT AU<LineBreak/>
          <Run Text="指揮官"/>
          <Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
          <Run Text="DARWIN NT AU"/><LineBreak/>
          COMAUSFLT CANBERRA ACT AU
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="主旨"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="N4 戰備通報 - 達爾文彈藥"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        機密
        <LineBreak/>
        電文分隔
        <LineBreak/><LineBreak/>
        1.（機密）摘要：由菲律賓庫存轉運的關鍵彈藥船隊，成功向南通過龍目海峽後，於 7 月 19 日抵達達爾文。卸載作業正由太平洋勤務部隊管制進行。
        <LineBreak/><LineBreak/>
        2.（機密）物資狀態：
      </TextBlock>

      <Border Padding="8" Margin="0,4,0,8">
        <Grid TextElement.FontSize="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="項目／系列"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="狀態"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,0" Text="RIM-66E／RIM-67B 標準飛彈"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="達爾文已接收供相容 Mk 13／Mk 26 艦艇使用的戰鬥裝載。"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,0" Text="RGM-84C/D 魚叉飛彈"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="已接收筒裝與單發彈體，可供相容艦艇使用。"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,12,0" Text="艦砲彈藥"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="已接收 5 吋/54、5 吋/38、76mm、40mm 與 20mm 庫存。"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,12,0" Text="點防禦"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="20mm 近迫武器系統、箔條、誘餌與噪音器。"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,12,0" Text="反潛儲備"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="Mk 46 艦載／機載魚雷、RUR-5 阿斯洛克、聲納浮標與深水炸彈。"/>
        </Grid>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="16">
        3.（機密）時程：完整分發須依艦體優先順序、彈艙相容性與預期任務進行管制發放。未授權放寬一般彈藥消耗限制。
        <LineBreak/><LineBreak/>
        4.（機密）本司令部注意到，此次龍目海峽通行之所以成功，是因收文特遣隊派出一艘美國軍艦獨立行動。該艦在敵方空中、水面與潛艦威脅下守住海峽，阻止蘇聯襲擊艦封閉通道，為船隊爭取到向南脫離所需的數小時。
        <LineBreak/><LineBreak/>
        5.（機密）意見：建議太平洋艦隊司令通知第 77 特遣隊，達爾文後勤狀況因龍目海峽行動成功而直接改善。
        <LineBreak/><LineBreak/>
        署名：R. M. HALVERSON
        <LineBreak/>
        上校，補給隊，美國海軍
        <LineBreak/>
        太平洋勤務部隊達爾文分遣隊／N4
        <LineBreak/><LineBreak/>
        電文分隔
        <LineBreak/>
        機密 依原機關決定解密
      </TextBlock>
    </StackPanel>
  </Border>
</ScrollViewer>
